FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./

# Install dependencies directly without strict package build requirements
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e . --no-deps || pip install --no-cache-dir fastapi uvicorn pydantic websockets httpx aiosqlite pydantic-settings cryptography pytest pytest-asyncio

COPY . .

EXPOSE 8000
CMD ["uvicorn", "app.__main__:create_app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--factory"]
